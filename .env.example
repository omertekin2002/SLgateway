# Required grounded Google research
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Primary OpenAI-compatible generation path (configure both URL and key, or omit both)
PRIMARY_LLM_BASE_URL=https://your-primary-provider.example/v1
PRIMARY_LLM_API_KEY=replace-with-a-primary-provider-key
PRIMARY_LLM_MODEL=gpt-5.6-luna

# Ordered fallback path (optional when the primary path is configured)
OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Service settings
PUBLIC_SERVICE_URL=http://localhost:10000
APP_NAME=SignLoop Chat Service
PORT=10000
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_MS=180000

# Comma-separated explicit origins; leave empty to disable CORS
CORS_ALLOWED_ORIGINS=
